{
  "name": "threekingdoms-simulation",
  "version": "1.0.0",
  "description": "Autonomous Grand Strategy Simulation Engine with AgentOption Modular Architecture",
  "main": "src/server/main.ts",
  "scripts": {
    "audit": "node tools/sim-audit.js",
    "migrate": "node tools/migrations/run.js",
    "migrate:status": "node tools/migrations/run.js --status",
    "dev:server": "tsx watch src/server/main.ts",
    "dev:client": "vite",
    "dev": "tsx watch src/server/main.ts",
    "build:client": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "node tools/test-runner.js",
    "test:legacy": "node tools/test-runner.js --legacy",
    "test:modern": "node tools/test-runner.js --modern",
    "verify": "npm run typecheck && npm run lint && npm run lint:client && npm run lint:ui && npm run lint:slop && npm run lint:api && npm run routes:shadow && npm run test && npm run golden:verify && npm run smoke:write",
    "lint:api": "node tools/client-api-contract.js --strict",
    "lint": "node tools/arch-guard.js",
    "lint:client": "node tools/client-syntax-check.js",
    "lint:ui": "node tools/ui-consistency-report.js",
    "lint:slop": "node tools/anti-slop-lint.js",
    "routes:shadow": "node tools/route-shadow-report.js --strict",
    "smoke:write": "node tools/write-smoke.js",
    "golden:record": "node tools/api-golden.js --record",
    "golden:verify": "node tools/api-golden.js",
    "perf:record": "node tools/perf-probe.js --record",
    "perf:compare": "node tools/perf-probe.js --compare",
    "mcp": "tsx src/mcp/server.ts",
    "test:mcp": "tsx tests/test-mcp.ts",
    "start": "tsx src/server/main.ts"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3"
  },
  "engines": {
    "node": ">=26"
  }
}
